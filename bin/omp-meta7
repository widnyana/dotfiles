#!/usr/bin/env bash
# Usage: omp-meta7 PROMPT [omp args...]
#   PROMPT  path to a prompt file, or - to read stdin
#   args    passed through to omp
# Env:
#   OMP_META7_PROMPT   system prompt path
#                      (default: <script-dir>/../agents/meta7.prompt,
#                       then $HOME/.dotfiles/agents/meta7.prompt)
#   OMP_META7_MODEL    omp model id (empty = omp default)
#   OMP_META7_PRINT    non-empty and not 0/false/no/off = one-shot print mode (-p)
# Portability: the system prompt is resolved as <script-dir>/../agents/meta7.prompt,
# falling back to $HOME/.dotfiles/agents/meta7.prompt. On a machine with a different
# layout, keep that tree shape, set OMP_META7_PROMPT, or edit default_prompt below.
#
# Model: this launcher has no model default. Set OMP_META7_MODEL to an id your omp
# provider or router serves, or leave it empty for the omp default. To pin one, edit
# the OMP_META7_MODEL branch below, or export the id before calling (a per-run export
# wins over nothing else and affects every wrapper that later reads it).
#
# Tools: the --tools list below is passed to omp verbatim; change it if your omp build
# exposes different tool names.
set -euo pipefail

prog=${0##*/}

usage_text() {
  printf 'usage: %s PROMPT [omp args...]\n' "$prog"
  printf '  PROMPT  path to a prompt file, or - to read stdin\n'
  printf '  args    passed through to omp\n'
}

usage() {
  if [ "$1" -eq 0 ]; then
    usage_text
  else
    usage_text >&2
  fi
  exit "$1"
}

die() {
  printf '%s: %s\n' "$prog" "$*" >&2
  exit 1
}

resolve_self() {
  local self=$1 target
  while [ -L "$self" ]; do
    target=$(readlink "$self") || exit 1
    case $target in
      /*) self=$target ;;
      *) self=$(cd -P -- "$(dirname -- "$self")" && pwd -P)/$target ;;
    esac
  done
  printf '%s\n' "$self"
}

readable_file() {
  [ -r "$1" ] && [ ! -d "$1" ]
}

self=$(resolve_self "${BASH_SOURCE[0]}")
script_dir=$(cd -P -- "$(dirname -- "$self")" && pwd -P)
default_prompt=$script_dir/../agents/meta7.prompt

[ $# -gt 0 ] || usage 2
case $1 in
  -h | --help) usage 0 ;;
  --) shift ;;
esac
[ $# -gt 0 ] || usage 2

prompt_file=$1
shift

if [ -n "${OMP_META7_PROMPT:-}" ]; then
  system_prompt=$OMP_META7_PROMPT
elif readable_file "$default_prompt"; then
  system_prompt=$default_prompt
elif [ -n "${HOME:-}" ] && readable_file "$HOME/.dotfiles/agents/meta7.prompt"; then
  system_prompt=$HOME/.dotfiles/agents/meta7.prompt
else
  system_prompt=
fi
[ -n "$system_prompt" ] || die "system prompt not found; set OMP_META7_PROMPT"
readable_file "$system_prompt" || die "system prompt not readable: $system_prompt"

command -v omp >/dev/null 2>&1 || die "omp not found in PATH"

args=(--tools "bash,read,write,edit,glob,grep,task,todo,web_search")
if [ -n "${OMP_META7_MODEL:-}" ]; then
  args+=(--model "$OMP_META7_MODEL")
fi
case ${OMP_META7_PRINT:-} in
  '' | 0 | false | no | off) ;;
  *) args=(-p "${args[@]}") ;;
esac

system_prompt_text=$(<"$system_prompt")

if [ "$prompt_file" = "-" ]; then
  exec omp "${args[@]}" --system-prompt "$system_prompt_text" "$@"
fi

[ -f "$prompt_file" ] || die "prompt file not found: $prompt_file"
prompt_dir=$(cd -P -- "$(dirname -- "$prompt_file")" && pwd -P)
exec omp "${args[@]}" --system-prompt "$system_prompt_text" "$@" "@$prompt_dir/${prompt_file##*/}"
