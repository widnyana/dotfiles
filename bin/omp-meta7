#!/usr/bin/env bash
# Run omp with the meta7 system prompt.
# Usage: omp-meta7 <prompt-file.md|-> [extra omp args...]
#   "-" reads the prompt from stdin.
# Env:
#   OMP_META7_PROMPT   system prompt path (default: $HOME/.dotfiles/agents/meta7.prompt)
#   OMP_META7_MODEL    omp model id (empty = omp default)
#   OMP_META7_PRINT    non-empty and not 0/false/no = one-shot print mode (-p)
set -euo pipefail

prog=${0##*/}

usage() {
  printf 'usage: %s <prompt-file.md|-> [extra omp args...]\n' "$prog" >&2
  exit "$1"
}

die() {
  printf '%s: %s\n' "$prog" "$*" >&2
  exit 1
}

[ $# -gt 0 ] || usage 2
case $1 in
  -h | --help) usage 0 ;;
esac

prompt_file=$1
shift

system_prompt=${OMP_META7_PROMPT:-$HOME/.dotfiles/agents/meta7.prompt}
[ -r "$system_prompt" ] || die "system prompt not readable: $system_prompt"

command -v omp >/dev/null 2>&1 || die "omp not found in PATH"

# Tool mapping from claude: Agent -> task, Task* -> todo, WebSearch -> web_search.
# WebFetch has no separate omp tool; read accepts URLs.
args=(--tools "bash,read,write,edit,glob,grep,task,todo,web_search")
if [ -n "${OMP_META7_MODEL:-}" ]; then
  args+=(--model "$OMP_META7_MODEL")
fi
case ${OMP_META7_PRINT:-} in
  '' | 0 | false | no) ;;
  *) args=(-p "${args[@]}") ;;
esac

if [ "$prompt_file" = "-" ]; then
  exec omp "${args[@]}" --system-prompt "$(<"$system_prompt")" "$@"
fi

[ -f "$prompt_file" ] || die "prompt file not found: $prompt_file"
prompt_dir=$(cd -- "$(dirname -- "$prompt_file")" && pwd -P)
prompt_path=$prompt_dir/${prompt_file##*/}

exec omp "${args[@]}" --system-prompt "$(<"$system_prompt")" "$@" "@${prompt_path}"
