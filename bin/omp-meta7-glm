#!/usr/bin/env bash
# Usage: omp-meta7-glm PROMPT [omp args...]
#   PROMPT  path to a prompt file, or - to read stdin
#   args    passed through to omp
# Env:
#   OMP_META7_MODEL   overrides the default GLM flash model below
# Portability: this wrapper prefers the sibling omp-meta7 in its own directory and falls
# back to PATH. On a machine with a different layout, keep both scripts in one directory
# or put omp-meta7 on PATH.
#
# Model: the default openrouter/~z-ai/glm-flash-latest is an OpenRouter alias. Edit the
# export line below, or set OMP_META7_MODEL for a one-off run. The id must exist in your
# provider or router (OpenRouter, z.ai, a local gateway); any id omp accepts works.
set -euo pipefail

prog=${0##*/}

usage_text() {
  printf 'usage: %s PROMPT [omp args...]\n' "$prog"
  printf '  PROMPT  path to a prompt file, or - to read stdin\n'
  printf '  args    passed through to omp\n'
}

usage() {
  if [ "$1" -eq 0 ]; then
    usage_text
  else
    usage_text >&2
  fi
  exit "$1"
}

die() {
  printf '%s: %s\n' "$prog" "$*" >&2
  exit 1
}

[ $# -gt 0 ] || usage 2
case $1 in
  -h | --help) usage 0 ;;
esac

script_dir=$(cd -P -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
launcher=$script_dir/omp-meta7
if [ ! -x "$launcher" ]; then
  launcher=$(command -v omp-meta7 || true)
fi
[ -n "$launcher" ] && [ -x "$launcher" ] || die "omp-meta7 not found beside $prog or in PATH"

export OMP_META7_MODEL=${OMP_META7_MODEL:-openrouter/~z-ai/glm-flash-latest}
exec "$launcher" "$@"
