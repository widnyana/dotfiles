#!/usr/bin/env bash
# Run opencode with the meta7 system prompt.
# Usage: opencode-meta7 PROMPT [opencode args...]
#   PROMPT  path to a prompt file, or - to read stdin
#   args    passed through to opencode
# Env:
#   OPENCODE_META7_CONFIG   opencode config defining the meta7 agent
#                           (default: $HOME/.dotfiles/agents/opencode-meta7.jsonc)
#   OPENCODE_META7_MODEL    opencode model as provider/model (empty = opencode default)
#   OPENCODE_META7_RUN      non-empty and not 0/false/no/off = one-shot `opencode run` (no steering)
# opencode has no system prompt flag, so the meta7 prompt is the prompt of an agent named
# meta7, defined in that config and loaded through OPENCODE_CONFIG. Only a --standalone run
# reads OPENCODE_CONFIG (the background service ignores it). Tool permissions come from
# the user's opencode config.
set -euo pipefail

prog=${0##*/}

usage_text() {
  printf 'usage: %s PROMPT [opencode args...]\n' "$prog"
  printf '  PROMPT  path to a prompt file, or - to read stdin\n'
  printf '  args    passed through to opencode\n'
}

usage() {
  if [ "$1" -eq 0 ]; then
    usage_text
  else
    usage_text >&2
  fi
  exit "$1"
}

die() {
  printf '%s: %s\n' "$prog" "$*" >&2
  exit 1
}

[ $# -gt 0 ] || usage 2
case $1 in
  -h | --help) usage 0 ;;
esac

prompt_file=$1
shift

config=${OPENCODE_META7_CONFIG:-$HOME/.dotfiles/agents/opencode-meta7.jsonc}
[ -r "$config" ] || die "opencode config not readable: $config"

command -v opencode >/dev/null 2>&1 || die "opencode not found in PATH"

if [ "$prompt_file" = "-" ]; then
  message=$(cat)
else
  [ -f "$prompt_file" ] || die "prompt file not found: $prompt_file"
  message=$(<"$prompt_file")
fi
[ -n "$message" ] || die "prompt is empty"

case ${OPENCODE_META7_RUN:-} in
  '' | 0 | false | no | off) args=(mini --standalone --agent meta7) tail=(--prompt "$message") ;;
  *) args=(run --standalone --agent meta7) tail=("$message") ;;
esac
if [ -n "${OPENCODE_META7_MODEL:-}" ]; then
  args+=(--model "$OPENCODE_META7_MODEL")
fi

export OPENCODE_CONFIG=$config

exec opencode "${args[@]}" "$@" "${tail[@]}"
