[alias]
	# all commits that aren't merges on all branches
	all = !git log --pretty=oneline --abbrev-commit --all --no-merges
	br = branch --format='%(HEAD) %(color:yellow)%(refname:short)%(color:reset) - %(contents:subject) %(color:green)(%(committerdate:relative)) [%(authorname)]' --sort=-committerdate
	cm = commit -m
	co = checkout
	cob = checkout -b
	d = diff
	del = branch -D
	gr = log --graph --decorate --oneline
	last = log -1 HEAD --stat
	lg = !git log --pretty=format:\"%C(magenta)%h%Creset -%C(red)%d%Creset %s %C(dim green)(%cr) [%an]\" --abbrev-commit -30
	ll = log --oneline
	lol = log --graph --pretty=format:'%C(auto)%h%d%Creset %C(cyan)(%cr)%Creset %C(green)%cn <%ce>%Creset %s'
	lol2 = "log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit"
	lold = log --graph --pretty=format:\"%C(auto)%h%d%Creset %C(cyan)(%ci)%Creset %C(green)%cn <%ce>%Creset %s\"
	rso = remote show origin
	rv = remote -v
	s = status
	se = !git rev-list --all | xargs git grep -F
	st = status -sb
	# find the top level of current repository
	top = !git rev-parse --show-toplevel
	unstage = reset HEAD
	undo-commit = reset --soft HEAD^
	find-merge = "!sh -c 'commit=$0 && branch=${1:-HEAD} && (git rev-list $commit..$branch --ancestry-path | cat -n; git rev-list $commit..$branch --first-parent | cat -n) | sort -k2 -s | uniq -f1 -d | sort -n | tail -1 | cut -f2'"
	show-merge = "!sh -c 'merge=$(git find-merge $0 $1) && [ -n \"$merge\" ] && git show $merge'"

[init]
	defaultBranch = main

[color]
	diff = auto
	status = auto
	branch = auto
	interactive = auto
	ui = true
	pager = true

[color "status"]
	added = green
	changed = blue
	untracked = magenta
	deleted = red

[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true

[core]
	packedGitLimit = 512m
	packedGitWindowSize = 512m
	bigFileThreshold = 50m

[fetch]
	parallel = 32

[help]
	autocorrect = 0

[user]
	# email + signingkey are per-machine — see [include] below.
	useConfigOnly = true
	name = widnyana

[pull]
	rebase = true

[diff]
	submodule = log

[gitbutler]
	utmostDiscretion = 1

[pack]
	windowMemory = 100m
	packSizeLimit = 100m

[commit]
	gpgsign = true

[tag]
	gpgSign = true

# Portability boundary. Everything above is identical on macOS and Fedora and
# assumes only that `git`, `git-lfs`, and (for signing) `gpg` are on $PATH — no
# absolute paths, no OS conditionals. Anything machine-specific — user.email,
# user.signingkey, a non-PATH gpg binary, credential helpers — goes in
# config.local, which is git-ignored. Git skips this include silently when the
# file is absent. Seed it from config.local.example (the installer does this).
[include]
	path = ~/.config/git/config.local
