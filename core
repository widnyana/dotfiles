#!/usr/bin/env bash

#: GPG — TTY for terminal pinentry / commit signing. OS-agnostic; needed on
#: macOS (GPG Suite) and Fedora alike.
export GPG_TTY=$(tty)

#: direnv — per-directory env. One init, here; not in paths or devs.
if [[ -x "$(command -v direnv)" ]]; then
  eval "$(direnv hook zsh)"
fi

#: Ruby user gems — same layout on macOS and Fedora when ruby is present.
#: version dir resolved by glob so it survives ruby minor bumps.
if command -v ruby >/dev/null 2>&1; then
  export GEM_HOME="$HOME/.gem"
  export PATH="$GEM_HOME/bin:$PATH"
  for _gembin in "$HOME"/.gem/ruby/*/bin(N); do export PATH="$_gembin:$PATH"; done
  unset _gembin
fi

#    ▗       ▌ ▘
#  ▛▘▜▘▀▌▛▘▛▘▛▌▌▛▌
#  ▄▌▐▖█▌▌ ▄▌▌▌▌▙▌
#               ▌
#: prompt init + completions — here (not ~/.zshrc) so a stock ~/.zshrc still
#: gets the prompt on a fresh box.
if type "starship" >>/dev/null; then
  # shellcheck source=/dev/null
  eval "$(starship init zsh)"
  # shellcheck source=/dev/null
  source <(starship completions zsh)
fi

#     ▘
#  ▛▛▌▌▛▘█▌
#  ▌▌▌▌▄▌▙▖
# mise env (MISE_*) lives in vendor/oh-my-zsh/dot-zshrc — it must be set before
# oh-my-zsh loads its `mise` plugin. Activation is that plugin's job. Nothing here.

#: fzf — key bindings + completion. `fzf --zsh` (fzf >= 0.48) replaces the old
#: ~/.fzf.zsh / $XDG_CONFIG_HOME/fzf/fzf.zsh source lines. Works with the
#: mise-provided fzf.
if type "fzf" >>/dev/null; then
  # shellcheck source=/dev/null
  source <(fzf --zsh)
fi

#    ▗   ▘
#  ▀▌▜▘▌▌▌▛▌
#  █▌▐▖▙▌▌▌▌
#
#: atuin zsh completion cached in ${DOT_DIR}/completions/_atuin, see bin/refresh-completions.sh
if type "atuin" >>/dev/null; then
  # shellcheck source=/dev/null
  source <(atuin init zsh)
fi

#: zellij zsh completion + zr/zrf/ze pane aliases, cached in ${DOT_DIR}/completions/_zellij, see bin/refresh-completions.sh
#: stderr silenced: the generated script self-invokes _zellij outside a completion
#: context on source, which prints a harmless "can only be called from completion
#: function" warning; functions/completion still register correctly.
if type "zellij" >>/dev/null; then
  # shellcheck source=/dev/null
  source "${DOT_DIR}/completions/_zellij" 2>/dev/null
fi