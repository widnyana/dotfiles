#: glab zsh completion cached in ${DOT_DIR}/completions/_glab, see bin/refresh-completions.sh

#: python-gitlab CLI (`gitlab`) argcomplete registration - unrelated to glab above
if type "gitlab" > /dev/null 2>&1; then
  python3 -m pip install --user --upgrade argcomplete > /dev/null 2>&1
  activate-global-python-argcomplete > /dev/null 2>&1
fi

if type "register-python-argcomplete" > /dev/null 2>&1; then
  eval "$(register-python-argcomplete gitlab)"
fi


