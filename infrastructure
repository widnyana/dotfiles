# Infrastructure / ops tooling. One block per tool — env, PATH, completion and
# aliases stay together. Completions marked "cached" are regenerated by
# bin/refresh-completions.sh into completions/_<tool> (on $FPATH), not live here.

# ─── Kubernetes: kubectl, krew, ouctl, fubectl ───
if [[ -x "$(command -v kubectl)" ]]; then
  export KUBE_TMUX_BINARY="$(which kubectl)"
fi
#: kubectl completion — cached (_kubectl)

#: krew — https://github.com/kubernetes-sigs/krew
PATH=${PATH}:${KREW_ROOT:-$HOME/.krew}/bin

if type "kubectl-ouctl" > /dev/null 2>&1; then
  source <(kubectl ouctl completion zsh)
fi

#: fubectl — https://github.com/kubermatic/fubectl
#: sources/fubectl.source is vendored in the repo (upstream + the ked->kedit and
#: kdel->kdelete renames). Update it by hand; no fetch/sed at shell start (GNU
#: sed -i is not portable to macOS).
[ -f "$HOME/.dotfiles/sources/fubectl.source" ] && source "$HOME/.dotfiles/sources/fubectl.source"

# ─── Minikube ───
#: completion — cached (_minikube)
if type "minikube" >> /dev/null; then
  export MINIKUBE_HOME=$HOME/Development/Infrastructure/labs/minikube/_MINIKUBE_HOME
  export MINIKUBE_IN_STYLE=false
  [[ -d "${MINIKUBE_HOME}" ]] || mkdir -p "${MINIKUBE_HOME}"
fi

# ─── Docker ───
if type "docker" > /dev/null; then
  export BUILDKIT_PROGRESS=plain
fi

# ─── Helm / pack / trivy ───
#: helm, trivy completions — cached (_helm, _trivy)
if type "pack" > /dev/null; then
  source <(pack completion --shell zsh)
fi

# ─── Istio ───
#: istioctl completion — cached (_istioctl)
export PATH="${PATH}:$HOME/.istioctl/bin"

# ─── Terraform / OpenTofu / Terragrunt ───
export TG_PROVIDER_CACHE=1
export TG_PROVIDER_CACHE_DIR="${HOME}/Development/sdks/terragrunt/cache"
export TF_REGISTRY_CLIENT_TIMEOUT=15
export TF_PROVIDER_DOWNLOAD_RETRY=2
export TF_PLUGIN_CACHE_DIR=${HOME}/Development/sdks/opentofu/plugin-cache

#: resolve tofu wherever it is (mise data dir, brew, …) — no hardcoded path
if command -v tofu >/dev/null 2>&1; then
  complete -o nospace -C "$(command -v tofu)" tofu
fi

if type "terragrunt" > /dev/null 2>&1; then
  complete -o nospace -C "$(which terragrunt)" terragrunt
  alias tg=terragrunt
fi

if type "terraformer" > /dev/null; then
  alias tfer="$(which terraformer)"
fi

# ─── Hashicorp Vault ───
if type "vault" > /dev/null; then
  complete -o nospace -C $(which vault) vault
fi

# ─── Vagrant ───
export VAGRANT_HOME="${HOME}/Development/Infrastructure/vagrant.d"
export VAGRANT_DEFAULT_PROVIDER=virtualbox

# ─── GitLab: glab + python-gitlab CLI ───
#: glab completion — cached (_glab)
#: python-gitlab's `gitlab` CLI argcomplete (unrelated to glab). argcomplete
#: itself is a manual / mise-managed install — not pip-installed at shell start.
#: 2>/dev/null: the script carries a hardcoded python shebang; if that python
#: was pruned the call dies with "bad interpreter" — swallow it, eval "" no-ops.
if command -v gitlab > /dev/null 2>&1 && command -v register-python-argcomplete > /dev/null 2>&1; then
  eval "$(register-python-argcomplete gitlab 2>/dev/null)"
fi

# ─── Velero ───
#: completion — cached (_velero)
if type "velero" > /dev/null 2>&1; then
  alias v=velero
  source <(velero completion bash)
  complete -F __start_velero v
fi

# ─── Pinniped ───
#: completion — cached (_pinniped)

# ─── Cloud CLIs: aws, gcloud, aliyun ───
# aws-cli + session-manager-plugin (same install path on macOS and Fedora)
[[ -d /usr/local/sessionmanagerplugin/bin ]] && export PATH="/usr/local/sessionmanagerplugin/bin:$PATH"
if type "aws" > /dev/null; then
  if type "aws_completer" > /dev/null; then
    complete -C "$(which aws_completer)" aws
  fi
fi

if type "gcloud" > /dev/null; then
  export USE_GKE_GCLOUD_AUTH_PLUGIN=True
  export CLOUDSDK_PYTHON=$(which python3)
  export CLOUDSDK_PYTHON_SITEPACKAGES=1
  export CLOUDSDK_HOME=$(dirname $(dirname $(which gcloud)))
  [[ -f "${CLOUDSDK_HOME}/completion.$(basename ${SHELL}).inc" ]] && \
    source "${CLOUDSDK_HOME}/completion.$(basename ${SHELL}).inc"
fi

if type "aliyun" > /dev/null 2>&1; then
  complete -o nospace -C "$(which aliyun)" aliyun
fi

# ─── Ansible ───
#: ansible-playbook -e *_target_hosts= host completion (completions/_ansible-playbook),
#: overrides zsh's bundled generic _ansible completer
if type "compdef" > /dev/null 2>&1; then
  compdef _ansible-playbook ansible-playbook
fi
