  complete -o nospace -C "$(which aliyun)" aliyun
fi

#: Google Cloud SDK
if type "gcloud" > /dev/null; then
  export USE_GKE_GCLOUD_AUTH_PLUGIN=True
  export CLOUDSDK_PYTHON=$(which python3)
  export CLOUDSDK_PYTHON_SITEPACKAGES=1
  export CLOUDSDK_HOME=$(dirname $(dirname $(which gcloud)))
  [[ -f "${CLOUDSDK_HOME}/completion.$(basename ${SHELL}).inc" ]] && \
    source "${CLOUDSDK_HOME}/completion.$(basename ${SHELL}).inc"
fi 

if [[ -f $HOME/Development/sdks/mise/installs/opentofu/latest/tofu ]]; then 
  complete -o nospace -C $HOME/Development/sdks/mise/installs/opentofu/latest/tofu tofu
fi

if type "terragrunt" > /dev/null 2>&1; then
  complete -o nospace -C "$(which terragrunt)" terragrunt
  alias tg=terragrunt
fi
