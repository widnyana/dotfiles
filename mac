# macOS only. Sourced from loader.zsh on Darwin. OS-agnostic settings live in
# core / global_env; the Fedora peer is ./linux.

alias stree='open -a SourceTree'

export HOMEBREW_NO_ENV_HINTS=1
export HOMEBREW_NO_AUTO_UPDATE=1

# Homebrew (Apple Silicon prefix) + keg-only ruby
export PATH="/opt/homebrew/bin:/opt/homebrew/sbin:/opt/homebrew/opt/ruby/bin:$PATH"

# mac-only tools
export PATH="$HOME/Applications/CMake.app/Contents/bin:$HOME/.orbstack/bin:$PATH"
