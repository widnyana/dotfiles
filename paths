# XDG_CONFIG_HOME + friends live in global_env (sourced first). direnv init
# lives in core. This file only builds $PATH.
export PATH=$PATH:/usr/local/bin:/bin:/usr/bin

export LOCALPATH
LOCALPATH=${HOME}/.dotfiles/bin:$HOME/Development/bin

#: export new PATH
LOCALPATH=$HOME/.local/bin:$HOME/bin:$LOCALPATH
export PATH=$LOCALPATH:$PATH
