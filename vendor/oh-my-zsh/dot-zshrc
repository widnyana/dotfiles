# Repo-managed ~/.zshrc. bin/install-dotfiles.sh links this to ~/.zshrc.
#
# This file is oh-my-zsh setup ONLY. Everything portable — prompt, locale,
# editor, PATH, tool init — lives in the ${DOT_DIR} load chain, sourced from
# ~/.oh-my-zsh/custom/loader.zsh by `source $ZSH/oh-my-zsh.sh` below. Machine-
# specific lines go in ~/.zshrc.local (git-ignored), sourced at the end.

# Path to your oh-my-zsh installation.
export ZSH="${HOME}/.oh-my-zsh"

# Theme is set by `omz`; the prompt is Starship (see ${DOT_DIR}/core).
ZSH_THEME=""

CASE_SENSITIVE="false"
DISABLE_AUTO_TITLE="true"

zstyle ':omz:update' mode reminder
zstyle ':omz:update' frequency 13
zstyle ':completion:*' menu select

plugins=(
    git
    fzf
    themes
    mise
    direnv
    docker
)

fpath+=${ZSH_CUSTOM:-${ZSH:-~/.oh-my-zsh}/custom}/plugins/zsh-completions/src

source $ZSH/oh-my-zsh.sh
## loader.zsh (the ${DOT_DIR} chain) is sourced from here, via
## $OMZ_PATH/custom/loader.zsh — managed by bin/install-dotfiles.sh

autoload -U +X bashcompinit && bashcompinit -i
autoload -U +X compinit && compinit -i

# Machine-local overrides (git-ignored; seeded from dot-zshrc.local.example)
[ -f ~/.zshrc.local ] && source ~/.zshrc.local
